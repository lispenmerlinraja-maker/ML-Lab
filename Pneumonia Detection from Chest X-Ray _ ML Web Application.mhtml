@charset "utf-8";

:root { --bg-main: #0b1120; --bg-card: #131d33; --bg-card-hover: #192642; -=
-bg-inner: #0a0f1d; --border-color: rgba(255, 255, 255, 0.09); --border-hig=
hlight: rgba(14, 165, 233, 0.35); --text-primary: #f8fafc; --text-secondary=
: #94a3b8; --text-muted: #64748b; --color-cyan: #0ea5e9; --color-cyan-glow:=
 rgba(14, 165, 233, 0.25); --color-success: #10b981; --color-danger: #ef444=
4; --color-warning: #f59e0b; --font-sans: 'Plus Jakarta Sans', system-ui, -=
apple-system, sans-serif; --font-mono: 'JetBrains Mono', monospace; }

body { background-color: var(--bg-main); color: var(--text-primary); font-f=
amily: var(--font-sans); line-height: 1.6; overflow-x: hidden; min-height: =
100vh; }

.disclaimer-banner { background: linear-gradient(90deg, rgb(69, 26, 3) 0%, =
rgb(120, 53, 15) 50%, rgb(69, 26, 3) 100%); border-bottom: 1px solid rgba(2=
45, 158, 11, 0.3); color: rgb(254, 243, 199); font-size: 0.85rem; }

.disclaimer-text { color: rgb(254, 240, 138); font-size: 0.85rem; }

.glass-nav { background: rgba(11, 17, 32, 0.85); backdrop-filter: blur(16px=
); border-bottom: 1px solid var(--border-color); }

.brand-icon { width: 42px; height: 42px; border-radius: 12px; background: r=
gba(14, 165, 233, 0.12); border: 1px solid rgba(14, 165, 233, 0.3); display=
: flex; align-items: center; justify-content: center; font-size: 1.4rem; }

.brand-title { font-size: 1.25rem; font-weight: 800; letter-spacing: -0.5px=
; color: rgb(255, 255, 255); }

.brand-subtitle { font-size: 0.68rem; color: var(--text-secondary); text-tr=
ansform: uppercase; letter-spacing: 1px; }

.nav-link { font-weight: 500; font-size: 0.92rem; transition: 0.2s; color: =
var(--text-secondary) !important; }

.nav-link:hover, .nav-link.active { color: var(--color-cyan) !important; }

.text-cyan { color: var(--color-cyan) !important; }

.text-gradient { background: linear-gradient(135deg, rgb(56, 189, 248) 0%, =
rgb(129, 140, 248) 100%) text; -webkit-text-fill-color: transparent; }

.x-small { font-size: 0.78rem; }

.fw-mono { font-family: var(--font-mono); }

.hero-card, .content-card, .metric-card { background-color: var(--bg-card);=
 border: 1px solid var(--border-color); transition: transform 0.2s, border-=
color 0.2s; }

.hero-card { background: radial-gradient(circle at right top, rgba(14, 165,=
 233, 0.12), transparent 45%), linear-gradient(rgb(19, 29, 51) 0%, rgb(13, =
21, 39) 100%); }

.content-card:hover { border-color: var(--border-highlight); }

.status-pill { background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(=
14, 165, 233, 0.25); color: var(--color-cyan); font-size: 0.75rem; }

.status-dot { width: 7px; height: 7px; border-radius: 50%; background-color=
: var(--color-cyan); box-shadow: 0 0 8px var(--color-cyan); }

.terminal-snippet { background: rgb(5, 8, 17); padding: 8px 14px; border-ra=
dius: 8px; font-family: var(--font-mono); border: 1px solid rgba(255, 255, =
255, 0.08); display: inline-block; }

.terminal-snippet code { color: rgb(56, 189, 248); font-size: 0.85rem; }

.tech-stack-card { background: rgba(10, 15, 29, 0.75); border: 1px solid va=
r(--border-color); }

.tech-list li { padding: 6px 0px; font-size: 0.88rem; color: rgb(203, 213, =
225); border-bottom: 1px solid rgba(255, 255, 255, 0.04); }

.tech-list li:last-child { border-bottom-width: medium; border-bottom-style=
: none; border-bottom-color: currentcolor; }

.pipeline-step-box { background: rgba(10, 15, 29, 0.6); border: 1px solid v=
ar(--border-color); }

.step-num { display: inline-block; width: 22px; height: 22px; line-height: =
22px; border-radius: 50%; background: var(--color-cyan); color: rgb(0, 0, 0=
); font-size: 0.75rem; font-weight: 700; margin-bottom: 4px; }

.step-label { font-size: 0.75rem; color: var(--text-secondary); font-weight=
: 600; }

.dropzone { border: 2px dashed rgba(14, 165, 233, 0.35); background: rgba(1=
0, 15, 29, 0.5); cursor: pointer; transition: 0.25s; }

.dropzone:hover, .dropzone.drag-over { border-color: var(--color-cyan); bac=
kground: rgba(14, 165, 233, 0.08); transform: scale(0.995); }

.upload-icon-circle { width: 72px; height: 72px; border-radius: 50%; backgr=
ound: rgba(14, 165, 233, 0.1); display: flex; align-items: center; justify-=
content: center; transition: 0.25s; }

.dropzone:hover .upload-icon-circle { transform: translateY(-4px); backgrou=
nd: rgba(14, 165, 233, 0.2); }

.btn-cyan { background: linear-gradient(135deg, rgb(14, 165, 233) 0%, rgb(2=
, 132, 199) 100%); color: rgb(255, 255, 255); border-width: medium; border-=
style: none; border-color: currentcolor; border-image: none; box-shadow: rg=
ba(14, 165, 233, 0.3) 0px 4px 14px; transition: 0.2s; }

.btn-cyan:hover:not(:disabled) { background: linear-gradient(135deg, rgb(56=
, 189, 248) 0%, rgb(3, 105, 161) 100%); color: rgb(255, 255, 255); transfor=
m: translateY(-1px); box-shadow: rgba(14, 165, 233, 0.4) 0px 6px 20px; }

.btn-cyan:disabled { background: rgb(30, 41, 59); color: rgb(100, 116, 139)=
; box-shadow: none; cursor: not-allowed; }

.btn-outline-cyan { color: var(--color-cyan); border: 1px solid var(--color=
-cyan); background: transparent; }

.btn-outline-cyan:hover { background: rgba(14, 165, 233, 0.1); color: rgb(5=
6, 189, 248); border-color: rgb(56, 189, 248); }

.preview-box { background: rgb(8, 12, 22); border: 1px solid var(--border-c=
olor); min-height: 260px; position: relative; }

#imagePreview { max-height: 280px; object-fit: contain; }

.image-compare-box { background: rgb(8, 12, 22); border: 1px solid var(--bo=
rder-color); height: 150px; display: flex; align-items: center; justify-con=
tent: center; }

.prep-thumb { max-height: 134px; object-fit: contain; }

.placeholder-thumb { height: 100%; width: 100%; }

.chart-box { background: rgb(8, 12, 22); border: 1px solid var(--border-col=
or); min-height: 240px; }

.chart-box img { max-height: 240px; object-fit: contain; cursor: pointer; t=
ransition: transform 0.2s; }

.chart-box img:hover { transform: scale(1.02); }

#miniPredictionCard { background: rgb(8, 12, 22); border: 1px solid var(--b=
order-color); }

.confidence-circle-wrap { display: inline-block; padding: 18px 32px; border=
-radius: 20px; background: rgba(10, 15, 29, 0.8); border: 1px solid var(--b=
order-color); }

.progress-tall { height: 12px; }

.prediction-badge { letter-spacing: 1px; font-weight: 800; }

.badge-normal { box-shadow: rgba(16, 185, 129, 0.4) 0px 0px 20px; backgroun=
d: linear-gradient(135deg, rgb(16, 185, 129) 0%, rgb(5, 150, 105) 100%) !im=
portant; }

.badge-pneumonia { box-shadow: rgba(239, 68, 68, 0.4) 0px 0px 20px; backgro=
und: linear-gradient(135deg, rgb(239, 68, 68) 0%, rgb(185, 28, 28) 100%) !i=
mportant; }

.diagnostic-note { background: rgba(10, 15, 29, 0.7); border-color: var(--b=
order-color) !important; }

.metric-card { border-top: 3px solid var(--color-cyan); }

.metric-icon-wrap { font-size: 1.8rem; height: 48px; width: 48px; border-ra=
dius: 12px; background: rgba(255, 255, 255, 0.03); display: flex; align-ite=
ms: center; justify-content: center; }

.stat-tile { background: rgba(10, 15, 29, 0.7); border: 1px solid var(--bor=
der-color); }

.stat-value { font-size: 1.3rem; }

.icon-badge { width: 36px; height: 36px; border-radius: 10px; display: flex=
; align-items: center; justify-content: center; font-size: 1.1rem; }

.channel-bar-item { font-size: 0.75rem; font-family: var(--font-mono); }

.footer { background-color: rgb(7, 11, 21); }

@media (min-width: 992px) {
  .border-end-lg { border-right: 1px solid var(--border-color); }
}
